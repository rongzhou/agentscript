{
  "name": "@rong/agentscript",
  "version": "0.1.12",
  "description": "A DSL for explicit, scoped, auditable LLM context",
  "main": "dist/index.js",
  "bin": {
    "agentscript": "dist/bin/agentscript.js"
  },
  "files": [
    "dist",
    "examples",
    "recipes",
    "tutorials",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "INSTALL.md",
    "agentscript.npm.json"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin/agentscript.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "agentscript": "npm run build --silent && node dist/bin/agentscript.js",
    "parse": "npm run agentscript -- --parse",
    "check": "npm run agentscript -- --check",
    "execute": "npm run agentscript --",
    "execute:mock": "npm run agentscript -- --mock",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "keywords": [
    "agentscript",
    "llm",
    "llm-agent",
    "agent",
    "ai-agent",
    "agent-framework",
    "ai-workflow",
    "multi-agent",
    "context-engineering",
    "prompt-engineering",
    "structured-output",
    "dsl",
    "prompt",
    "react-agent",
    "tool-use",
    "automation",
    "workflow"
  ],
  "author": "Rong Zhou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rongzhou/agentscript.git"
  },
  "bugs": {
    "url": "https://github.com/rongzhou/agentscript/issues"
  },
  "homepage": "https://github.com/rongzhou/agentscript#readme",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
