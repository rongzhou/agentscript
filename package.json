{
  "name": "@rong/agentscript",
  "version": "0.1.3",
  "description": "AgentScript context engineering language runtime",
  "main": "dist/index.js",
  "bin": {
    "agentscript": "dist/bin/agentscript.js"
  },
  "files": [
    "dist",
    "examples",
    "tutorials",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "INSTALL.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin/agentscript.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "agentscript": "npm run build --silent && node dist/bin/agentscript.js",
    "parse": "npm run agentscript -- --parse",
    "check": "npm run agentscript -- --check",
    "execute": "npm run agentscript --",
    "execute:llm": "npm run agentscript -- --real-llm"
  },
  "keywords": [
    "agentscript",
    "llm",
    "agent",
    "ai-agent",
    "multi-agent",
    "context-engineering",
    "dsl",
    "prompt",
    "react-agent",
    "tool-use",
    "automation",
    "workflow"
  ],
  "author": "Rong Zhou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rongzhou/agentscript.git"
  },
  "bugs": {
    "url": "https://github.com/rongzhou/agentscript/issues"
  },
  "homepage": "https://github.com/rongzhou/agentscript#readme",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
